#N canvas 100 100 700 460 12;
#X text 30 10 OpenGlitch Phase 1: stereo passthrough with a bypass parameter.;
#X text 330 10 bypass=0 passes audio \, bypass=1 mutes (10ms ramp).;
#X obj 30 60 adc~;
#X obj 330 60 r bypass @hv_param 0 1 0;
#X obj 330 100 * -1;
#X obj 330 130 + 1;
#X obj 330 160 pack f 10;
#X obj 330 190 line~;
#X obj 200 60 loadbang;
#X msg 200 100 0;
#X obj 30 250 *~;
#X obj 130 250 *~;
#X obj 30 330 dac~;
