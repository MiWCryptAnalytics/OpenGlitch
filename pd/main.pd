#N canvas 50 50 900 640 12;
#X text 20 10 OpenGlitch Phase 2: 16-step glitch sequencer. glitch_clock broadcasts the per-step effect index \; all effects run in parallel and the selected one is gated in with a 5ms crossfade. Reader effects (tapestop \, retrigger \, shuffler \, reverser \, stretcher) tap the shared 4s capture buffers instead of taking direct input.;
#X text 20 80 Effect indices: 0 dry \, 1 tapestop \, 2 modulator \, 3 retrigger \, 4 shuffler \, 5 reverser \, 6 crusher \, 7 gater \, 8 delay \, 9 stretcher.;
#X obj 30 140 adc~;
#X obj 250 140 delwrite~ glitchbufL 4000;
#X obj 470 140 delwrite~ glitchbufR 4000;
#X obj 700 140 glitch_clock;
#X obj 30 240 fx_dry;
#X obj 130 240 fx_modulator;
#X obj 260 240 fx_crusher;
#X obj 370 240 fx_gater;
#X obj 470 240 fx_delay;
#X obj 30 330 fx_tapestop;
#X obj 160 330 fx_retrigger;
#X obj 290 330 fx_shuffler;
#X obj 420 330 fx_reverser;
#X obj 550 330 fx_stretcher;
#X obj 30 440 glitch_master;
#X obj 30 540 dac~;
#X obj 250 440 glitch_post;
